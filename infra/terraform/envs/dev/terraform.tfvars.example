# このファイルをコピーして terraform.tfvars を作成し、実値を設定する。
#   cp terraform.tfvars.example terraform.tfvars
# terraform.tfvars は .gitignore 済み（コミット禁止）。

# GCP プロジェクト ID
project_id = "phoenixdevops"

# リージョン（既定: asia-northeast1 / 東京）
region = "asia-northeast1"

# 環境識別子
environment = "dev"

# Cloud Storage ロケーション
storage_location = "ASIA-NORTHEAST1"

# 保持日数（dev のコスト最適化用。本番相当では要見直し）
uploads_retention_days = 30
results_retention_days = 90

# dev で作り直しを容易にしたい場合のみ true。中身ごと削除可能になるため注意。
force_destroy = false

# 解析ワーカー Cloud Functions
analysis_worker_function_name                     = "phoenixdevops-dev-analysis-worker"
analysis_worker_source_bucket_name                = null
analysis_worker_runtime                           = "nodejs24"
analysis_worker_service_account_id                = "pdx-dev-worker"
analysis_task_invoker_service_account_id          = "pdx-dev-task-invoker"
analysis_worker_available_memory                  = "1Gi"
analysis_worker_timeout_seconds                   = 540
analysis_worker_min_instance_count                = 0
analysis_worker_max_instance_count                = 3
analysis_worker_max_instance_request_concurrency = 1
analysis_worker_ingress_settings                  = "ALLOW_ALL"
analysis_worker_results_prefix_template           = "results/{job_id}"
analysis_worker_gemini_model                      = "gemini-2.0-flash"
analysis_worker_gemini_dry_run                    = false

# HTTP API Cloud Functions
api_function_name                     = "phoenixdevops-dev-api"
api_source_bucket_name                = null
api_runtime                           = "nodejs24"
api_service_account_id                = "pdx-dev-api"
api_available_memory                  = "1Gi"
api_timeout_seconds                   = 300
api_min_instance_count                = 0
api_max_instance_count                = 3
api_max_instance_request_concurrency = 1
api_ingress_settings                  = "ALLOW_ALL"
api_allow_unauthenticated             = true
firestore_uploads_collection          = "uploads"
api_signed_url_expiration_seconds     = 3600
api_uploads_prefix_template           = "uploads/{upload_id}"
api_results_prefix_template           = "results/{job_id}"
api_max_document_files                = 600

# Gemini API key は実値を tfvars に書かない。Secret Manager の secret ID のみ指定する。
# 未指定時は GEMINI_API_KEY を設定せず、アプリ側の dry-run client にフォールバックする。
gemini_api_key_secret_id      = null
gemini_api_key_secret_version = "latest"
