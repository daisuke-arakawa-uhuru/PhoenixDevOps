{
  "name": "phoenixdevops-analysis-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud Tasks triggered analysis worker for PhoenixDevOps.",
  "main": "dist/src/index.js",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "gcp-build": "npm run build",
    "start": "functions-framework --target=runAnalysisWorker",
    "test": "npm run build && node --test dist/test/*.js",
    "local": "tsx src/local-runner.ts",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/functions-framework": "^3.4.6",
    "@google-cloud/storage": "^7.16.0",
    "@google/genai": "^1.0.0",
    "pdf-parse": "^1.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
