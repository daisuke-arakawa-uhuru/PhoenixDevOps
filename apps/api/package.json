{
  "name": "phoenixdevops-drift-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions HTTP API for PhoenixDevOps drift agent.",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "tsc",
    "start": "npm run build && functions-framework --target=driftApi",
    "test": "npm run build && node --test dist/test/*.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "@google-cloud/functions-framework": "^3.4.6",
    "@google-cloud/storage": "^7.16.0",
    "@google-cloud/tasks": "^5.5.0",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
