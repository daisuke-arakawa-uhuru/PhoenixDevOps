{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform init:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(terraform apply:*)"
    ],
    "deny": [
      "Bash(terraform destroy:*)",
      "Bash(gcloud * delete:*)",
      "Bash(gsutil rm:*)",
      "Read(./**/*.tfvars)",
      "Read(./**/.env)",
      "Read(./**/*-key.json)",
      "Read(./**/secrets/**)"
    ]
  }
}